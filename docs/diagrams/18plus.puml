@startuml
' ---- Layout & Stil ----
hide empty methods
' ---- Legende ----
legend right
<<RichType>>: Stark typisierte Primitive
<<ValueObject>>: Value Objects
<<entity>>: Persistente Entität
<<unique>>: Eindeutige Einschränkung auf Spaltenebene
<<nn>>: Not null
endlegend
' ===================== Packages =====================
    class EntityBase << (A,#A9DCDF) Entität >> {
        +ID: Guid
        +CreatedAt: DateTime
        +CreatedBy: string
        +EditedAt: DateTime
        +EditedBy: string   
    }
  
    class EighteenplusException << (C,#AFD3B4)  >> {  
    }
  
    class Exception << (C,#AFD3B4)  >> {
    
    }
  
    class Group <<(C,#AFD3B4) Entität >> {
        +Name: string <<nn>>
        +JoinCode: int <<nn>> <<unique>>
        +CreatedAt: DateTime <<nn>>
        +Students: List<Student>
        +Teacher: Teacher <<nn>>
    }
  
package "User" as P_User #FFDBE6 {
    class UserBase << (C,#AFD3B4) Entität >> {
        +FirstName: string <<nn>>
        +LastName: string <<nn>>
        +E-MailAddress: string <<nn>> <<unique>>
    }
    class Admin << (C,#AFD3B4) Entität >> {
        +FirstName: string <<nn>>
        +LastName: string <<nn>>
        +E-MailAddress: string <<nn>> <<unique>>
        +Password: string <<nn>>
    }
    class Teacher << (C,#AFD3B4) Entität >> {
        +FirstName: string <<nn>>
        +LastName: string <<nn>>
        +E-MailAddress: string <<nn>> <<unique>>
        +Password: string <<nn>>
    }
    class Student << (C,#AFD3B4) Entität >> {
        +FirstName: string <<nn>>
        +LastName: string <<nn>>
        +E-MailAddress: string <<nn>> <<unique>>
        +Group: Group?  
    }
}
 
    class Results << (C, #AFD3B4) Entität >> {
        +Description: string <<null>>
        +UpdatedAt: DateTime <<nn>>
        +SubmittedAt: DateTime <<nn>>
        --
        +Status: WorkingStatus
    }
    
    class WorkingStatus << (C, #F5F4D6) Enums >> {
        draft
        submitted
        in_progress
        cancelled
    }
 
    class ClassNumber << (R,#FF746C) RichType >> {
        +Name: Group <<nn>>
    }
    
    class Worksheets << (R, #FF746C) RichType >> {
        +Name: string <<nn>>

        
    }
    
    
  
  UserBase --|> EntityBase
  Admin --|> UserBase
  Teacher --|> UserBase
  Student --|> UserBase
  EighteenplusException --|> Exception
  Student "n"-->"0.1" Group
  Group "1"-->"1" ClassNumber  
  Teacher "1"-->"0.n" Group
  Group --|> EntityBase
  Results --|> EntityBase
  Results --> WorkingStatus
  
 
  
 
@enduml
