@startuml
' ---- Layout & Stil ----
hide empty methods
' ---- Legende ----
legend right
<<RichType>>: Stark typisierte Primitive
<<ValueObject>>: Value Objects
<<entity>>: Persistente Entität
<<unique>>: Eindeutige Einschränkung auf Spaltenebene
<<nn>>: Not null
endlegend
' ===================== Packages =====================
    class EntityBase << (A,#A9DCDF) Entity >> {
        +ID: Guid
        +CreatedAt: DateTime
        +CreatedBy: string
        +EditedAt: DateTime
        +EditedBy: string   
    }
  
    class EighteenplusException << (C,#AFD3B4)  >> {  
    }
  
    class Exception << (C,#AFD3B4)  >> {
    
    }
  
    class Group <<(C,#AFD3B4) Entity >> {
        +Name: string <<nn>>
        +JoinCode: int <<nn>> <<unique>>
        +Students: List<Student>
        +Teacher: Teacher <<nn>>
    }
package "User" as P_User #FFDBE6 {
    class UserBase << (C,#AFD3B4) Entity >> {
        +FirstName: string <<nn>>
        +LastName: string <<nn>>
        +E-MailAddress: string <<nn>> <<unique>>
    }
    class Admin << (C,#AFD3B4) Entity >> {
        +Password: string <<nn>>
        --
        -CreateTeacher(FirstName, LastName, E-MailAddress)
        -DeleteTeacher(string E-MailAddress): bool
        -CreateGroup(Name, JoinCode, Students)
    }
    class Teacher << (C,#AFD3B4) Entity >> {
        +Password: string <<nn>>
        --
        -CreateGroup(Name, JoinCode, Students)
        -ViewWorkingStatusOfStudent(Student): WorkingStatus
    }
    class Student << (C,#AFD3B4) Entity >> {
        +Group: Group?  
        --
        -JoinGroup(Group) 
        -LeveGrop(Group): bool
        -ViewResult(): Result   
    }
}
 
    class Results << (C, #AFD3B4) Entity >> {
        +Description: string <<nn>>
        +UpdatedAt: DateTime <<nn>>
        +SubmittedAt: DateTime <<nn>>
        +Student: Student <<nn>>
        +Worksheet: Worksheet <<nn>>
        +Status: WorkingStatus
    }
    
    class WorkingStatus << (E, #F5F4D6) Enums >> {
        draft
        submitted
        in_progress
        cancelled
    }
 
    class ClassNumber << (R,#FF746C) RichType >> {
        +Name: string <<nn>>
    }
    
    class Worksheet << (C, #AFD3B4) Entity >> {
        +Name: string <<nn>>

        
    }
    
    
  
  UserBase --|> EntityBase
  Admin --|> UserBase
  Teacher --|> UserBase
  Student --|> UserBase
  EighteenplusException --|> Exception
  Student "0..*"-->"0..1" Group
  Group "1" o-- "1" ClassNumber
  Teacher "1"-->"0..*" Group
  Group --|> EntityBase
  Results --|> EntityBase
  Results --> WorkingStatus
  Student "1" --> "0..*" Results
  Worksheet "1" --> "0..*" Results

 
  
 
@enduml
